# ============================================
# .gitignore - ZackCodes Portfolio
# ============================================

# Environment and sensitive credential overrides
.env
.env.local
.env.*.local
config.local.php

# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# IDE & Editor folders
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Log files & diagnostics
*.log
error_log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node modules (if build tools are introduced later)
node_modules/

# Local backup & temporary files
*.bak
*.tmp
*.temp
scratch/
